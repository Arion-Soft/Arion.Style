<UserControl
    x:Class="Arion.Style.Controls.Icon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Name="Root"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    d:DesignHeight="40"
    d:DesignWidth="40"
    d:Background="White"
    MinWidth="15" MinHeight="15" 
    Background="Transparent"
    mc:Ignorable="d">
    <Path
        Stretch="Uniform"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Data="{Binding ElementName=Root, Path=Image}"
        Fill="{Binding ElementName=Root, Path=Fill}"
        Stroke="{Binding ElementName=Root, Path=StrokeColor}"
        StrokeThickness="{Binding ElementName=Root, Path=Stroke}" />
</UserControl>

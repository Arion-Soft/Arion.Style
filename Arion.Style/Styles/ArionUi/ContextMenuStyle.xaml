<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wpf="clr-namespace:Arion.Style.AttachedProperties">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>
        
    <Style x:Key="ContextMenuStyle"
           TargetType="{x:Type ContextMenu}">

        <Setter Property="Background" Value="{StaticResource Pr200}" />
        <Setter Property="BorderBrush" Value="{StaticResource Pr500}" />
        <Setter Property="BorderThickness" Value="5" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="wpf:Hint.CornerRadius" Value="10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding wpf:Hint.CornerRadius}"
                        Padding="{TemplateBinding Padding}">

                        <ItemsPresenter
                            KeyboardNavigation.DirectionalNavigation="Cycle" />

                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
